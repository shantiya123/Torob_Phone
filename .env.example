# Django development configuration
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use PostgreSQL for shared development, staging, and production. SQLite is an
# explicit lightweight-development fallback only.
DB_ENGINE=postgresql
DB_NAME=torob_phone
DB_USER=torob_phone
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Credentialed frontend requests: list exact origins, never a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Refresh tokens are HttpOnly cookies. Set Secure=true with HTTPS in staging
# and production. SameSite=None also requires Secure=true.
JWT_REFRESH_COOKIE_NAME=torob_phone_refresh
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_DOMAIN=
JWT_REFRESH_COOKIE_PATH=/api/auth/

# Optional GapGPT configuration for natural-language search
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=

# Basket Offer reservations expire after this many minutes.
BASKET_RESERVATION_MINUTES=30

# Backend simulation (development/test databases only)
SIMULATION_BASE_URL=http://127.0.0.1:8000
SIMULATION_STAFF_USERNAME=
SIMULATION_STAFF_PASSWORD=
SIMULATION_ALLOW_DESTRUCTIVE=false
SIMULATION_ALLOW_LIVE_EXTERNAL=false
SIMULATION_REPORT_DIR=simulation/reports
SIMULATION_HTTP_TIMEOUT_SECONDS=15
SIMULATION_RANDOM_SEED=20260726

DJANGO_STATIC_ROOT=
DJANGO_MEDIA_ROOT=